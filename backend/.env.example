# ─────────────────────────────────────────────
# Evently Backend – Environment Variable Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=production

# Database (MySQL / PlanetScale / Railway etc.)
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=evently

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# Brevo (formerly Sendinblue) HTTPS Email API (Works on Render Free Tier without SMTP port blocks)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=evently.nexora@gmail.com
EMAIL_FROM_NAME=Evently

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Admin bootstrap (used on first deploy to seed the admin account)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@1234
ADMIN_NAME=Admin

# CORS - comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-frontend.vercel.app
